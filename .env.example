# Required only for the live OpenAI planner (demo/smoke use a deterministic planner).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Alternative planner provider. OAuth is intentionally deferred; use an API key now.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-sol
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=Laya Dynamics Agent
# Set to 0 for a clean GPT-only ablation.
USE_LAYA=1
# Local directory or Hub identifier understood by laya.load().
LAYA_CHECKPOINT=/path/to/laya/base-english
# Use cuda for campaigns (fail closed); use auto only for exploratory CPU fallback.
LAYA_DEVICE=cuda

